# Template para exportar variaveis ao executar o ingestion isoladamente.
# Este arquivo nao e carregado pela aplicacao.
ENVIRONMENT=development
LOG_LEVEL=INFO
INGESTION_PORT=8002
PIPELINE_SERVICE_URL=http://localhost:8001
PIPELINE_TIMEOUT_SECONDS=5
AI_STRUCTURING_SERVICE_URL=http://localhost:8003
AUDIO_MAX_BYTES=25000000
AUDIO_MAX_DURATION_SECONDS=3600
