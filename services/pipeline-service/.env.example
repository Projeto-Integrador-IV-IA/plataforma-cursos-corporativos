# Template para exportar variaveis ao executar o pipeline isoladamente.
# Este arquivo nao e carregado pela aplicacao e nunca deve conter credenciais reais.
ENVIRONMENT=development
LOG_LEVEL=INFO
PIPELINE_PORT=8001
AUDIO_MAX_BYTES=25000000
AUDIO_MAX_DURATION_SECONDS=3600
DATABASE_URL=
AUTH_SERVICE_KEY=
