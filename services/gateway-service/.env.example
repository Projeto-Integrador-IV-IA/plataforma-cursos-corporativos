# Template para exportar variaveis ao executar o gateway isoladamente.
# Este arquivo nao e carregado pela aplicacao e nunca deve conter segredos reais.
ENVIRONMENT=development
LOG_LEVEL=INFO
GATEWAY_PORT=8000
PIPELINE_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
AI_STRUCTURING_SERVICE_URL=http://localhost:8003
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
