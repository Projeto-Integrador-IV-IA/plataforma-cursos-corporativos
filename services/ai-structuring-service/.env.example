# Template para exportar variaveis ao executar o servico isoladamente.
# Este arquivo nao e carregado pela aplicacao e nunca deve conter chaves reais.
ENVIRONMENT=development
LOG_LEVEL=INFO
AI_STRUCTURING_PORT=8003
PIPELINE_SERVICE_URL=http://localhost:8001
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
