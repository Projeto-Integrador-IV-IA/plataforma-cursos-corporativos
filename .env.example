# =============================================================================
# Plataforma de Cursos Corporativos - variaveis de ambiente (TEMPLATE)
# -----------------------------------------------------------------------------
# RNF11: este arquivo e um TEMPLATE. Copie para `.env` e preencha localmente.
# NUNCA versione o `.env` nem cole segredos reais aqui.
#   cp .env.example .env
# =============================================================================

# ---------- Geral ----------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_USER=cursos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cursos_corporativos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cursos:troque-esta-senha@localhost:5432/cursos_corporativos

# ---------- Portas dos servicos ----------
GATEWAY_PORT=8000
PIPELINE_PORT=8001
INGESTION_PORT=8002
AI_STRUCTURING_PORT=8003
WEB_PORT=5173

# ---------- URLs internas (comunicacao entre microsservicos) ----------
PIPELINE_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
AI_STRUCTURING_SERVICE_URL=http://localhost:8003

# ---------- Autenticacao (RF16 / RNF10) ----------
JWT_SECRET_KEY=gere-uma-chave-aleatoria-longa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Provedor de LLM (RNF03, RNF05, RNF12) ----------
LLM_PROVIDER=mock              # provedor a definir na PoC (Fase 2); use "mock" para desenvolver
LLM_MODEL=a-definir            # definido apos a avaliacao comparativa da Fase 2
LLM_API_KEY=coloque-sua-chave-aqui
LLM_TIMEOUT_SECONDS=30           # RNF05: falha/timeout nao pode perder a demanda bruta
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2              # RNF03: saida consistente

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
