# =============================================================================
# Plataforma de Cursos Corporativos - variaveis de ambiente (TEMPLATE)
# -----------------------------------------------------------------------------
# RNF11: este arquivo e um TEMPLATE. Copie para `.env` e preencha localmente.
# NUNCA versione o `.env` nem cole segredos reais aqui.
#   cp .env.example .env
# Campos sensiveis ficam vazios de proposito e sao obrigatorios quando usados:
# o docker-compose.yml recusa subir a stack enquanto eles nao forem preenchidos.
# =============================================================================

# ---------- Geral ----------
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_USER=cursos
POSTGRES_PASSWORD=
POSTGRES_DB=cursos_corporativos
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Formato: postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# ---------- Portas dos servicos ----------
GATEWAY_PORT=8000
PIPELINE_PORT=8001
INGESTION_PORT=8002
# RNF13: tamanho maximo da fonte original, em caracteres (minimo configuravel: 10).
SOURCE_TEXT_MAX_LENGTH=50000
AI_STRUCTURING_PORT=8003
WEB_PORT=5173

# ---------- URLs internas (comunicacao entre microsservicos) ----------
PIPELINE_SERVICE_URL=http://pipeline-service:8001
# Prazo do ingestion para a confirmacao do bruto no pipeline (RF09, RNF05).
PIPELINE_TIMEOUT_SECONDS=5
INGESTION_SERVICE_URL=http://ingestion-service:8002
AI_STRUCTURING_SERVICE_URL=http://ai-structuring-service:8003
# RF30: limites de captacao de audio, compartilhados com o pipeline.
AUDIO_MAX_BYTES=25000000
AUDIO_MAX_DURATION_SECONDS=3600

# ---------- Autenticacao (RF16 / RNF10) ----------
# Minimo de 32 caracteres; gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Minimo de 32 caracteres; compartilhada somente entre gateway e pipeline.
AUTH_SERVICE_KEY=

# ---------- Provedor de LLM (RNF03, RNF05, RNF12) ----------
# Provedor a definir na PoC (Fase 2); use "mock" para desenvolver.
LLM_PROVIDER=mock
# Definido apos a avaliacao comparativa da Fase 2.
LLM_MODEL=mock
LLM_API_KEY=
# Endpoint do provedor http; vazio quando LLM_PROVIDER=mock.
LLM_BASE_URL=
LLM_COMPLETIONS_PATH=/chat/completions
# Opcional: atribuicao enviada ao OpenRouter (HTTP-Referer).
LLM_HTTP_REFERER=
# Opcional: atribuicao enviada ao OpenRouter (X-Title).
LLM_APP_TITLE=
# RNF05: falha/timeout nao pode perder a demanda bruta.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# RNF05: teto proprio para resposta fora do schema do curso.
LLM_SCHEMA_MAX_RETRIES=2
# RNF03: saida consistente.
LLM_TEMPERATURE=0.2
# RNF22: teto diario de tokens; vazio = sem alerta de consumo.
#
# ATENCAO: nao deixe comentario na mesma linha do valor, nem quando o valor
# fica vazio de proposito. O parser de `.env` do Docker Compose SO remove um
# comentario apos um VALOR REAL (ex. "mock              # comentario" fica
# "mock"); quando o valor e vazio, o texto do comentario e lido como se FOSSE
# o valor da variavel, e qualquer campo nao-string (int, float, bool) quebra
# a validacao do Settings na primeira requisicao. Foi exatamente isso que
# aconteceu aqui antes desta correcao - ver auditoria de 17/11/2026.
LLM_DAILY_TOKEN_BUDGET=
# RF29 (card #160): mock | fastembed.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RF29 (cards #161/#162): liga a recuperacao por similaridade.
RETRIEVAL_ENABLED=false
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2
RETRIEVAL_MAX_CONTEXT_CHARS=8000

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
